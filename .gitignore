# ============================================================
# Python 项目 .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- 虚拟环境（本地独有，不入库）----
.venv/
venv/
env/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 运行输出 ----
output/
logs/
*.log

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 本地配置（含仪器 IP / 串口号等现场信息）----
config/local*
